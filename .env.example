# ─────────────────────────────────────────────────────────────────────────────
# Kaam — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's public URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your project's anon/public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your project's service-role key (server-side ONLY — never expose to browser)
# Used for admin operations that bypass RLS (e.g. super-admin actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — used to verify Supabase auth tokens server-side (optional)
# Found in: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Next.js ───────────────────────────────────────────────────────────────────
# The canonical URL of your deployment (no trailing slash)
# Dev:        http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── App Config ────────────────────────────────────────────────────────────────
# Name shown in the UI and emails
NEXT_PUBLIC_APP_NAME=Kaam

# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE
# ─────────────────────────────────────────────────────────────────────────────
# 1. cp .env.example .env.local
# 2. Fill in values from your Supabase project dashboard
# 3. Restart the dev server: npm run dev
# ─────────────────────────────────────────────────────────────────────────────

# --- Web Push (background notifications when browser is closed) ---------------
#
# Step 1 — Generate a VAPID key pair (run in this project folder):
#   npx web-push generate-vapid-keys
# It prints two lines, for example:
#   Public Key:
#   BFx...long-string...xyz
#   Private Key:
#   abc...long-string...123
#
# Step 2 — Copy them into the variables below EXACTLY as printed (no quotes).
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY
#   Paste the "Public Key" value here. This name must stay as-is (NEXT_PUBLIC_
#   exposes it to the browser for push subscription). Safe to commit in .env.example
#   only as empty; put the real value in .env.local.
#
# VAPID_PRIVATE_KEY
#   Paste the "Private Key" value here. Server-only — never commit real values;
#   never prefix with NEXT_PUBLIC_. Used by /api/webhooks/notification-push to
#   sign outgoing pushes.
#
# VAPID_SUBJECT
#   A contact the push service can use if something breaks. Use either:
#   - mailto:your-email@example.com   (recommended), or
#   - https://your-production-domain.com
#   Replace with your real email or site URL; keep the mailto: or https: prefix.
#
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
#
# PUSH_WEBHOOK_SECRET
#   Any long random string (e.g. openssl rand -hex 32). You will set the SAME
#   value in Supabase: Database → Webhooks → your hook → HTTP Headers,
#   e.g. Name: x-webhook-secret   Value: <paste this secret>
#   The webhook URL must be: https://<your-domain>/api/webhooks/notification-push
#
PUSH_WEBHOOK_SECRET=7f3c9a2b1e8d4f6a0c5b7e9d2f4a8c1e6b3d9f0a7c2e5b8d1f4a6c9e0b3d7f2
